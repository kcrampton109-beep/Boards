cfb/snapshots/
cfb/data/*.parquet
!cfb/data/market_proj.parquet
!cfb/data/weather.parquet
cfb/board/*.parquet
cfb/board/state.json
cfb/board/scores.json
cfb/board/publish/
cfb/exports/
# NFL: third-party history (nflverse, Action Network, SportsbookReview) and regenerated tables live in the Actions cache
nfl/data/
nfl/snapshots/
nfl/board/state.json
nfl/board/scores.json
nfl/stage/
nfl/exports/
_checkin/
_wb_*/
# CBB research: third-party raw data (Action Network, ESPN) and derived tables stay out of the public repo
cbb/data/
cbb/board/state.json
